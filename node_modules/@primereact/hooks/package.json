{
  "name": "@primereact/hooks",
  "version": "11.2.2",
  "author": "PrimeTek Informatics",
  "description": "Hooks for PrimeReact components.",
  "homepage": "https://primereact.dev",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primefaces/primereact-nextchapter.git",
    "directory": "packages/@primereact/hooks"
  },
  "bugs": {
    "url": "https://support.primeui.dev"
  },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./*": {
      "types": "./*/index.d.ts",
      "import": "./*/index.mjs",
      "default": "./*/index.mjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@primeuix/utils": "^0.8.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "type": "module"
}