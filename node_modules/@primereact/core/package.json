{
  "name": "@primereact/core",
  "version": "11.2.2",
  "author": "PrimeTek Informatics",
  "description": "Core components for PrimeReact.",
  "homepage": "https://primereact.dev",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primefaces/primereact-nextchapter.git",
    "directory": "packages/@primereact/core"
  },
  "bugs": {
    "url": "https://support.primeui.dev"
  },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./*": {
      "types": "./*/index.d.ts",
      "import": "./*/index.mjs",
      "default": "./*/index.mjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@primeui/license-manager": "^1.0.0",
    "@primeuix/styled": "^1.2.0",
    "@primeuix/utils": "^0.8.3",
    "@primeuix/motion": "^1.0.0",
    "@primeuix/locale": "^0.1.0",
    "@primereact/hooks": "11.2.2",
    "@primereact/types": "11.2.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "type": "module"
}